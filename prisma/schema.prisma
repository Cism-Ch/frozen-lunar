generator client {
  provider      = "prisma-client-js"
  output        = "../node_modules/.prisma/client"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// --- Modèles d'Authentification (Better-Auth) ---

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  role          String   @default("user") // admin, moderator, developer, user
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions       Session[]
  accounts       Account[]
  companyProfile CompanyProfile?
  quotes         Quote[]
  supportThreads SupportThread[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

// --- Modèles de Métier (Quotes & Logistique) ---

enum QuoteStatus {
  PENDING   // En attente
  VALIDATED // Validé
  REJECTED  // Refusé
  CANCELLED // Annulé par le client
}

enum QuoteSource {
  FORM
  CHAT
}

enum VehicleCategory {
  HEAVY_HAUL // Transport lourd & Engins (Porte-char, Grue)
  CONTAINERS // Porte-conteneurs & Plateaux
  MATERIALS  // Bennes & Matériaux BTP
  PASSENGER  // Transport de personnel & Navettes (Bus, Coaster)
  UTILITY    // Utilitaires & Tout-terrain (Pick-up 4x4, Fourgon)
}

model Vehicle {
  id                String          @id @default(cuid())
  slug              String          @unique
  name              String
  category          VehicleCategory
  capacityLabel     String
  description       String          @db.Text
  totalQuantity     Int             @default(1)
  availableQuantity Int             @default(1)
  dailyRateFcfa     Int?
  imageUrl          String?
  specs             Json?
  recommendedFor    String[]        @default([])
  isActive          Boolean         @default(true)
  sortOrder         Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  quotes Quote[]

  @@map("vehicle")
}

model Quote {
  id                 String      @id @default(cuid())
  trackingCode       String?     @unique
  date               DateTime    @default(now())
  clientName         String
  email              String
  phone              String
  itemType           String
  pickupLocation     String
  dropoffLocation    String
  transportDate      DateTime
  status             QuoteStatus @default(PENDING)
  amount             String      @default("À calculer")
  userNotes          String?
  cancellationReason String?     @db.Text
  cancelledAt        DateTime?
  source             QuoteSource @default(FORM)

  // Optional client user account owner (IDOR isolation)
  userId          String?
  user            User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Optional vehicle selection & requested quantity
  vehicleId       String?
  vehicle         Vehicle?    @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  vehicleQuantity Int         @default(1)

  // Storage for specific questions or details
  supplementaryInfo Json?

  history       QuoteHistory[]
  supportThread SupportThread?

  @@map("quote")
}

model QuoteHistory {
  id          String   @id @default(cuid())
  action      String
  description String?
  timestamp   DateTime @default(now())
  user        String   @default("Système")

  quoteId String
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@map("quote_history")
}

// --- Modèles de Contact & Messagerie ---

enum ContactStatus {
  UNREAD // Non lu
  READ // Lu
  ARCHIVED // Archivé
}

model ContactMessage {
  id        String        @id @default(cuid())
  firstName String
  lastName  String
  email     String
  phone     String
  message   String        @db.Text
  status    ContactStatus @default(UNREAD)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("contact_message")
}

// --- Modèle de Paramètres Système & Entreprise (Singleton) ---

model SystemSettings {
  id                       String   @id @default("default")
  companyName              String   @default("HBC SERVICE CASH LOGISTIQUE IMMOBILIÈRE")
  address                  String   @default("123 Avenue du Transport, 75000 Paris")
  siret                    String   @default("123 456 789 00012")
  vatNumber                String   @default("FR 12 345678900")
  contactEmail             String   @default("contact@hbclogistique.com")
  contactPhone             String   @default("+33 1 23 45 67 89")

  // WhatsApp & IA Hugging Face
  whatsappNumber           String   @default("+33 1 23 45 67 89")
  hfModel                  String   @default("mistralai/Mistral-7B-Instruct-v0.3")
  whatsappTemplate         String   @default("Bonjour {client}, nous faisons suite à votre demande de transport #{id} ({type}). Votre dossier est pris en charge par notre équipe.") @db.Text
  whatsappAiAutoGenerate   Boolean  @default(true)
  whatsappAutoAuditLog     Boolean  @default(true)
  whatsappCrossSearchPhone Boolean  @default(true)

  // Préférences de Notifications
  notifyNewQuoteEmail      Boolean  @default(true)
  notifyWeeklyReport       Boolean  @default(true)
  notifySystemUpdates      Boolean  @default(false)

  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@map("system_settings")
}

// --- Modèle Portail Partenaires Afrique (UEMOA / CEDEAO) ---

enum PartnerApplicationStatus {
  PENDING  // En étude conformité
  APPROVED // Partenaire agréé
  REJECTED // Candidature refusée
}

model PartnerApplication {
  id               String                   @id @default(cuid())
  partnerType      String                   @default("COMPANY") // INDIVIDUAL | COMPANY
  companyName      String
  rccmNumber       String?
  nccNumber        String?
  idDocumentNumber String?                  // N° CNI ou Permis pour Particulier
  country          String                   @default("Côte d'Ivoire")
  city            String
  contactName     String
  email           String
  phone           String
  whatsapp        String?
  fleetCategories String[]                 @default([])
  fleetSummary    String                   @db.Text
  totalVehicles   Int                      @default(1)
  operatingZones  String[]                 @default([])
  kycDocumentKeys String[]                 @default([])
  status          PartnerApplicationStatus @default(PENDING)
  adminNotes      String?                  @db.Text
  reviewedAt      DateTime?
  reviewedBy      String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@map("partner_application")
}

// --- Modèles Espace Client Entreprise & Chat Hybride IA + Validateur Humain ---

model CompanyProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountType    String   @default("INDIVIDUAL") // INDIVIDUAL | COMPANY
  companyName    String
  rccmNumber     String?
  nccNumber      String?
  phone          String
  defaultPickup  String?
  defaultDropoff String?
  savedAddresses Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("company_profile")
}

enum SupportThreadStatus {
  AI_ACTIVE      // Assistant IA actif en premier rideau
  HUMAN_TAKEOVER // Validateur humain a pris la main (IA en pause)
  RESOLVED       // Échange clôturé
}

enum SupportSenderRole {
  CLIENT
  AI
  ADMIN
}

model SupportThread {
  id         String              @id @default(cuid())
  quoteId    String              @unique
  quote      Quote               @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  status     SupportThreadStatus @default(AI_ACTIVE)
  assignedTo String?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  messages SupportMessage[]

  @@map("support_thread")
}

model SupportMessage {
  id         String            @id @default(cuid())
  threadId   String
  thread     SupportThread     @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderRole SupportSenderRole
  senderName String
  content    String            @db.Text
  createdAt  DateTime          @default(now())

  @@map("support_message")
}

// --- Suivi Persistant des Notifications Admin Acquittées ---

model AdminNotificationRead {
  id              String   @id @default(cuid())
  userId          String
  notificationKey String
  readAt          DateTime @default(now())

  @@unique([userId, notificationKey])
  @@map("admin_notification_read")
}


