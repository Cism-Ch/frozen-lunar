# Configuration de la base de données PostgreSQL (Supabase / local)
# REQUIS: DATABASE_URL pointe sur le Transaction Pooler (port 6543) avec ?pgbouncer=true en prod
DATABASE_URL="postgresql://username:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
# REQUIS: DIRECT_URL pointe sur la connexion directe (port 5432) pour les migrations prisma migrate
DIRECT_URL="postgresql://username:password@db.region.supabase.co:5432/postgres"

# URL de l'application (pour le développement local)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optionnel: Services externes
# Clé API Gemini pour les fonctionnalités IA (secret serveur prioritaire ou NEXT_PUBLIC_)
GEMINI_API_KEY="your_gemini_api_key"
NEXT_PUBLIC_GEMINI_API_KEY="your_gemini_api_key"

# Clé API Hugging Face (Access Token - type Fine-grained avec permission Inference ou Read)
HUGGINGFACE_API_KEY="your_huggingface_access_token"

# Numéro WhatsApp officiel HBC Logistique (format international sans espace ex: +33123456789 ou +22507000000)
NEXT_PUBLIC_WHATSAPP_NUMBER=""

# Service d'envoi d'emails Resend
RESEND_KEY="your_resend_api_key"

# Stockage Tigris S3 (optionnel)
TIGRIS_BUCKET_NAME="your_bucket_name"
TIGRIS_STORAGE_ACCESS_KEY_ID="your_access_key"
TIGRIS_STORAGE_SECRET_ACCESS_KEY="your_secret_key"
TIGRIS_STORAGE_ENDPOINT="https://fly.storage.tigris.dev"
NEXT_PUBLIC_TIGRIS_PUBLIC_URL="your_public_url"

# Redis Upstash pour le rate limiting (optionnel mais recommandé en production)
UPSTASH_REDIS_REST_URL="your_redis_url"
UPSTASH_REDIS_REST_TOKEN="your_redis_token"
# Paramètres du Rate Limiting (Optionnel, défaut: 20 requêtes par 10s)
RATE_LIMIT_MAX_REQUESTS="20"
RATE_LIMIT_WINDOW_SECONDS="10"

# Authentification Better-Auth
# REQUIS EN PRODUCTION: Clé secrète robuste (min 32 caractères) pour signer les sessions et tokens
BETTER_AUTH_SECRET="your_better_auth_secret_min_32_chars"

# Notifications Administrateur
ADMIN_NOTIFICATION_EMAIL="contact@hbc-logistique.fr"

# QStash pour les tâches en arrière-plan et webhooks
QSTASH_TOKEN="your_qstash_token"
# Clés de vérification de signature des webhooks QStash (requis en production)
QSTASH_CURRENT_SIGNING_KEY="your_qstash_current_signing_key"
QSTASH_NEXT_SIGNING_KEY="your_qstash_next_signing_key"

# Mode Seed de développement (Optionnel, "true" pour autoriser POST /api/seed en local)
ENABLE_SEED_ROUTE="false"

# Supabase Realtime (optionnel)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY="your_supabase_publishable_key"

